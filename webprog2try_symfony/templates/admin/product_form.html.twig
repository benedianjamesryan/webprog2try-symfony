{% extends 'admin/layout.html.twig' %}

{% block title %}{{ isNew ? 'Add' : 'Edit' }} Product — FROSTCORE{% endblock %}
{% block active_page %}products{% endblock %}
{% block admin_stylesheet %}<link rel="stylesheet" href="{{ asset('css/admin/products.css') }}">{% endblock %}

{% block admin_content %}
    <section class="page-title"><h1>{{ isNew ? 'Add product' : 'Edit product' }}</h1><p>Enter accurate product and inventory information.</p></section>
    {% for message in app.flashes('error') %}<p class="message error">{{ message }}</p>{% endfor %}
    <section class="product-form-card">
        <form class="product-form" method="post" action="{{ isNew ? path('admin_product_new') : path('admin_product_edit', {id: product.id}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('admin_product_' ~ (product.id ?? 'new')) }}">
            <div class="form-field"><label for="name">PRODUCT NAME</label><input id="name" name="name" maxlength="180" value="{{ product.name }}" required></div>
            <div class="form-field"><label for="category">CATEGORY</label><select id="category" name="category" required>{% for option in categories %}<option value="{{ option }}" {{ product.category == option ? 'selected' : '' }}>{{ option }}</option>{% endfor %}</select></div>
            <div class="form-field"><label for="price">PRICE (₱)</label><input id="price" name="price" type="number" min="0" max="99999999.99" step="0.01" value="{{ product.price }}" required></div>
            <div class="form-field"><label for="rating">RATING</label><input id="rating" name="rating" type="number" min="0" max="5" step="0.1" value="{{ product.rating }}" required></div>
            <div class="form-field"><label for="stock">STOCK</label><input id="stock" name="stock" type="number" min="0" step="1" value="{{ product.stock }}" required></div>
            <div class="form-field"><label for="image">PRODUCT IMAGE</label><select id="image" name="image" required>{% for image in images %}<option value="{{ image }}" {{ product.image == image ? 'selected' : '' }}>{{ image|split('/')|last }}</option>{% endfor %}</select></div>
            <div class="form-field full"><label for="description">DESCRIPTION</label><textarea id="description" name="description" required>{{ product.description }}</textarea></div>
            <div class="form-actions"><button class="save-button" type="submit">SAVE PRODUCT</button><a class="cancel-button" href="{{ path('admin_products') }}">CANCEL</a></div>
        </form>
    </section>
{% endblock %}
