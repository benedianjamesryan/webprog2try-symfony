{% extends 'admin/layout.html.twig' %}

{% block title %}Manage Brands — FROSTCORE{% endblock %}
{% block active_page %}brands{% endblock %}
{% block admin_stylesheet %}<link rel="stylesheet" href="{{ asset('css/admin/products.css') }}">{% endblock %}

{% block admin_content %}
    <section class="page-title"><h1>Brands</h1><p>Manage the brands available in the shop.</p></section>
    <div class="toolbar">
        <a class="add-button" href="{{ path('admin_brand_new') }}">+ ADD BRAND</a>
    </div>
    <div class="table-wrap"><table class="products-table brands-table">
        <thead><tr><th>ID</th><th>BRAND NAME</th><th>ACTIONS</th></tr></thead>
        <tbody>{% for brand in brands %}
            <tr>
                <td>{{ brand.id }}</td>
                <td>{{ brand.brandName }}</td>
                <td>
                    <a class="edit-link" href="{{ path('admin_brand_edit', {id: brand.id}) }}">EDIT</a>
                    {{ include('admin/brands/_delete_form.html.twig') }}
                </td>
            </tr>
        {% else %}<tr><td colspan="3" class="empty">No brands found.</td></tr>{% endfor %}</tbody>
    </table></div>
{% endblock %}
