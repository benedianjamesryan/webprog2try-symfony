{% extends 'admin/layout.html.twig' %}

{% block title %}Brand — FROSTCORE{% endblock %}
{% block active_page %}brands{% endblock %}
{% block admin_stylesheet %}<link rel="stylesheet" href="{{ asset('css/admin/products.css') }}">{% endblock %}

{% block admin_content %}
    <section class="page-title"><h1>{{ brand.brandName }}</h1><p>Brand details.</p></section>
    <section class="product-form-card">
        <p><strong>ID:</strong> {{ brand.id }}</p>
        <p><strong>Brand name:</strong> {{ brand.brandName }}</p>
        <a class="cancel-button" href="{{ path('admin_brand_index') }}">BACK TO BRANDS</a>
        <a class="edit-link" href="{{ path('admin_brand_edit', {id: brand.id}) }}">EDIT</a>
    </section>
{% endblock %}
