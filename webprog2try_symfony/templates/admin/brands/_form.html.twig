{{ form_start(form, {attr: {class: 'product-form'}}) }}
    <div class="form-field">
        {{ form_label(form.brandName, 'BRAND NAME') }}
        {{ form_widget(form.brandName) }}
        {{ form_errors(form.brandName) }}
    </div>
    <div class="form-actions">
        <button class="save-button" type="submit">{{ button_label|default('SAVE BRAND') }}</button>
        <a class="cancel-button" href="{{ path('admin_brand_index') }}">CANCEL</a>
    </div>
{{ form_end(form) }}
