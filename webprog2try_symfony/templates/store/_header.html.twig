<header class="products-header">
    <a class="brand" href="{{ path('home') }}">
        <img class="brand-logo" src="{{ asset('assets/logo/frostcore_logo.png') }}" alt="">
        <span>FROSTCORE</span>
    </a>
    <nav class="products-nav" aria-label="Store navigation">
        <a href="{{ path('home') }}" {{ app.request.attributes.get('_route') == 'home' ? 'aria-current="page"' : '' }}>Home</a>
        <a href="{{ path('app_products') }}" {{ app.request.attributes.get('_route') in ['app_products', 'app_product_details'] ? 'aria-current="page"' : '' }}>Shop</a>
        {% if app.user %}
            <a href="{{ path('app_about') }}" {{ app.request.attributes.get('_route') == 'app_about' ? 'aria-current="page"' : '' }}>About us</a>
            <a href="{{ path('app_contact') }}" {{ app.request.attributes.get('_route') == 'app_contact' ? 'aria-current="page"' : '' }}>Contact</a>
        {% endif %}
        {% if app.user %}
            <a href="{{ path('app_cart') }}" {{ app.request.attributes.get('_route') == 'app_cart' ? 'aria-current="page"' : '' }}>Cart{% if app.user.cartItems|length %} ({{ app.user.cartItems|length }}){% endif %}</a>
            <a href="{{ path('app_my_orders') }}" {{ app.request.attributes.get('_route') in ['app_my_orders', 'app_order_show'] ? 'aria-current="page"' : '' }}>My orders</a>
        {% endif %}
    </nav>
    <div class="header-actions">
        {% if app.user %}
            {% if is_granted('ROLE_ADMIN') %}<a class="admin-dashboard-link" href="{{ path('admin_dashboard') }}">ADMIN DASHBOARD</a>{% endif %}
            <form action="{{ path('app_logout') }}" method="post" data-logout-confirm>
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                <button class="logout-button" type="submit">LOG OUT</button>
            </form>
        {% else %}
            <a class="login-link" href="{{ path('app_login', {redirect: app.request.pathInfo}) }}">LOGIN</a>
        {% endif %}
    </div>
</header>
{% include 'store/_logout_confirmation.html.twig' %}
