<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Contact FROSTCORE</title>
    <link rel="stylesheet" href="{{ asset('css/style.css') }}">
    <link rel="stylesheet" href="{{ asset('css/contact.css') }}">
    <link rel="stylesheet" href="{{ asset('css/products.css?v=5') }}">
    <link rel="stylesheet" href="{{ asset('css/logout.css?v=1') }}">
</head>
<body>
{% include 'store/_header.html.twig' %}
<main class="contact-page">
    <section class="contact-hero">
        <span class="contact-eyebrow">WE'RE HERE TO HELP</span>
        <h1>Contact us</h1>
        <p>Questions about an order or choosing a cooler? Send our team a message.</p>
    </section>
    <section class="contact-grid">
        <div class="panel">
            <h2>Send a message</h2>
            <form id="contact-form">
                <div class="form-grid">
                    <div class="field"><label for="contact-name">Name</label><input id="contact-name" name="name" maxlength="150" required></div>
                    <div class="field"><label for="contact-email">Email</label><input id="contact-email" name="email" type="email" maxlength="190" required></div>
                    <div class="field full"><label for="contact-subject">Subject</label><input id="contact-subject" name="subject" maxlength="150" required></div>
                    <div class="field full"><label for="contact-message">Message</label><textarea id="contact-message" name="message" maxlength="3000" required></textarea></div>
                </div>
                <button class="submit" type="submit">OPEN EMAIL APP</button>
                <p class="info">This opens a draft in your email app; the site does not send or store contact messages.</p>
            </form>
        </div>
        <aside class="panel">
            <h2>Contact details</h2>
            <article class="contact-card"><span>EMAIL</span><a href="mailto:frostcorecoolers@gmail.com">frostcorecoolers@gmail.com</a><p>For product, order, or support questions.</p></article>
        </aside>
    </section>
</main>
<script>
document.getElementById('contact-form').addEventListener('submit', function (event) {
    event.preventDefault();
    const data = new FormData(event.currentTarget);
    const subject = encodeURIComponent(String(data.get('subject')));
    const body = encodeURIComponent(`Name: ${data.get('name')}\nEmail: ${data.get('email')}\n\n${data.get('message')}`);
    window.location.href = `mailto:frostcorecoolers@gmail.com?subject=${subject}&body=${body}`;
});
</script>
</body>
</html>
