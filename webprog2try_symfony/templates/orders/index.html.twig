<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>My orders — FROSTCORE</title>
    <link rel="stylesheet" href="{{ asset('css/style.css') }}">
    <link rel="stylesheet" href="{{ asset('css/my-orders.css?v=2') }}">
    <link rel="stylesheet" href="{{ asset('css/products.css?v=5') }}">
    <link rel="stylesheet" href="{{ asset('css/logout.css?v=1') }}">
</head>
<body>
{% include 'store/_header.html.twig' %}
<main class="orders-page">
    <section class="orders-title">
        <h1>My orders</h1>
        <p>Track your recent purchases and order status.</p>
    </section>
    <div class="orders-list">
        {% for order in orders %}
            <article class="order-card">
                <div class="order-card-top">
                    <div>
                        <div class="order-number">{{ order.orderNumber }}</div>
                        <p class="order-date">Placed {{ order.createdAt|date('M j, Y') }}</p>
                    </div>
                    <span class="status status-{{ order.status|lower }}">{{ order.status }}</span>
                </div>
                <div class="order-info">
                    <div class="order-info-box"><span>ORDER TOTAL</span><strong>₱{{ order.total|number_format(2) }}</strong></div>
                    <div class="order-info-box"><span>PAYMENT</span><strong>{{ order.paymentMethod }}</strong></div>
                    <div class="order-info-box"><span>ITEMS</span><strong>{{ order.items|length }}</strong></div>
                    <div class="order-info-box"><span>ORDER DATE</span><strong>{{ order.createdAt|date('M j, Y') }}</strong></div>
                </div>
                <a class="view-order" href="{{ path('app_order_show', {id: order.id}) }}">VIEW ORDER DETAILS</a>
            </article>
        {% else %}
            <section class="empty-orders">
                <h2>No orders yet</h2>
                <p>You have not placed any orders yet. Browse the shop to find a cooler for your setup.</p>
                <a class="shop-button" href="{{ path('app_products') }}">BROWSE PRODUCTS</a>
            </section>
        {% endfor %}
    </div>
</main>
</body>
</html>
