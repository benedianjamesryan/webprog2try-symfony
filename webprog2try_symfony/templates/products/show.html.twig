<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ product.name }} — FROSTCORE</title>
    <link rel="stylesheet" href="{{ asset('css/style.css?v=5') }}">
    <link rel="stylesheet" href="{{ asset('css/product-details.css?v=2') }}">
    <link rel="stylesheet" href="{{ asset('css/products.css?v=7') }}">
    <link rel="stylesheet" href="{{ asset('css/logout.css?v=2') }}">
</head>
<body>
{% include 'store/_header.html.twig' %}
<main class="product-details-page">
    <p class="product-back"><a href="{{ path('app_products') }}">← Back to products</a></p>
    {% for message in app.flashes('success') %}<p class="review-message review-success" role="status">{{ message }}</p>{% endfor %}
    {% for message in app.flashes('error') %}<p class="review-message review-error" role="alert">{{ message }}</p>{% endfor %}
    <section class="product-details">
        <div class="product-details-image"><img src="{{ asset(product.image) }}" alt="{{ product.name }}"></div>
        <div class="product-details-info">
            <p class="product-category">{{ product.category }}</p>
            <h1>{{ product.name }}</h1>
            <p class="product-rating"><span class="stars">★</span> {{ product.rating }} <span>out of 5</span></p>
            <p class="product-stock">
                {% if product.stock > 0 %}
                    <span class="stock-available">IN STOCK</span>
                    <span>{{ product.stock }} available</span>
                {% else %}
                    <span class="stock-out">OUT OF STOCK</span>
                {% endif %}
            </p>
            <div class="product-description">
                <h3>PRODUCT OVERVIEW</h3>
                <p>{{ product.description }}</p>
            </div>
            <strong class="product-details-price">₱{{ product.price|number_format(2) }}</strong>
            {% if app.user and product.stock > 0 %}
                <form class="add-to-cart-form" action="{{ path('app_cart_add', {id: product.id}) }}" method="post">
                    <input type="hidden" name="_token" value="{{ csrf_token('cart_add_' ~ product.id) }}">
                    <div class="quantity-box">
                        <label for="quantity">QUANTITY</label>
                        <input id="quantity" name="quantity" type="number" min="1" max="{{ product.stock }}" value="1" required>
                    </div>
                    <button class="add-cart-button" type="submit">ADD TO CART</button>
                </form>
            {% elseif not app.user %}
                <a class="add-cart-button" href="{{ path('app_login') }}">SIGN IN TO SHOP</a>
            {% else %}
                <button class="add-cart-button disabled" type="button" disabled>OUT OF STOCK</button>
            {% endif %}
        </div>
    </section>
    <section class="product-reviews">
        <h2>Customer reviews</h2>
        {% if app.user %}
            <form class="review-form" action="{{ path('app_product_details', {id: product.id}) }}" method="post">
                <h3>Write a review</h3>
                <input type="hidden" name="_token" value="{{ csrf_token('review_' ~ product.id) }}">
                <label class="rating-label" for="rating">YOUR RATING</label>
                <select class="review-rating" id="rating" name="rating" required><option value="">Choose a rating</option>{% for rating in 5..1 %}<option value="{{ rating }}">{{ rating }} / 5</option>{% endfor %}</select>
                <label class="review-textarea-label" for="review_text">YOUR REVIEW</label>
                <textarea class="review-textarea" id="review_text" name="review_text" maxlength="1000" required></textarea>
                <button class="review-submit" type="submit">SUBMIT REVIEW</button>
            </form>
        {% else %}
            <p class="review-notice"><a href="{{ path('app_login') }}">Sign in</a> to write a review.</p>
        {% endif %}
        <div class="review-list">
            {% for review in reviews %}
                <article class="review-card">
                    <div class="review-card-header">
                        <strong class="reviewer-name">{{ review.user.fullName }}</strong>
                        <span class="review-stars" aria-label="{{ review.rating }} out of 5 stars">{% for _ in 1..review.rating %}★{% endfor %}</span>
                    </div>
                    <p class="review-content">{{ review.reviewText }}</p>
                </article>
            {% else %}
                <p class="review-empty">No reviews yet. Be the first to share your experience.</p>
            {% endfor %}
        </div>
    </section>
</main>
</body>
</html>
